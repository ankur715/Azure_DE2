{
  "linkedServiceName": {
    "referenceName": "LS_ADLS",
    "type": "LinkedServiceReference"
  },
  "parameters": {
    "runDate": {
      "type": "string",
      "defaultValue": "1970-01-01"
    }
  },
  "type": "Parquet",
  "typeProperties": {
    "location": {
      "type": "AzureBlobFSLocation",
      "fileSystem": "bronze",
      "folderPath": {
        "value": "generation/ingest_date=@{dataset().runDate}",
        "type": "Expression"
      }
    },
    "compressionCodec": "snappy"
  }
}
