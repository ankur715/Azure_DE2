# Copy to .env and fill in. Never commit the real .env file.

# LLM — free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "-lite" models have separate, more generous free-tier daily quotas than
# flagship "flash" models — see chatbot/README.md's Gemini quota note.
LLM_MODEL=gemini-3.1-flash-lite

# Databricks SQL Warehouse (Unity Catalog gold tables)
# Find these under the warehouse's "Connection details" tab in Databricks.
DATABRICKS_SERVER_HOSTNAME=adb-XXXXXXXXXXXXXXXX.XX.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/XXXXXXXXXXXXXXXX

# Auth to the warehouse — use ONE of these two options.
# Option A: personal access token (simplest for local dev)
DATABRICKS_TOKEN=

# Option B: OAuth machine-to-machine (service principal) — preferred for anything
# beyond local testing, since it's not tied to a human user's PAT.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# App-level auth — generate any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRY_MINUTES=120

# Query guardrails
MAX_RESULT_ROWS=500
# A cold (auto-stopped) serverless warehouse can take well over 30s to resume.
QUERY_TIMEOUT_SECONDS=120

LOG_DB_PATH=chatbot_audit_log.db
